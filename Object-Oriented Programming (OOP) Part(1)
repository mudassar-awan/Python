        "    self.name = name # object/instance Attribute\n",
        "    self.marks = marks\n",
        "\n",
        "\n",
        "s1 = Student(\"ajmal\", 80)\n",
        "print(f\"{s1.name} got {s1.marks} from {s1.schoolname} \")\n",
        "\n",
        "print(Student.schoolname) # we can also print the class Attribute in this waay\n",
        "print(s1.name) # it always print object attribute becuase obj Attribute precedence > clas|s Attribute\n",
