      }
    },
    {
      "cell_type": "code",
      "source": [
        "class Account:\n",
        "    def __init__(self, balance, account_no):\n",
        "        # Private attributes (encapsulation)\n",
        "        self.__balance = balance        # Balance is hidden from direct access\n",
        "        self.__account_no = account_no  # Account number is hidden from direct access\n",
        "\n",
        "    def debit(self, amount):\n",
        "        # Instance method to withdraw money safely\n",
        "        self.__balance -= amount\n",
        "        print(f\"{amount} debited. {self.get_balance()}\")  # Use getter to display balance\n",
        "\n",
        "    def credit(self, amount):\n",
        "        # Instance method to deposit money safely\n",
        "        self.__balance += amount\n",
        "        print(f\"{amount} credited. {self.get_balance()}\")  # Use getter to display balance\n",
        "\n",
        "    def get_balance(self):\n",
        "        # Getter method to safely access the private balance\n",
        "        return f\"Balance is {self.__balance}\"\n",
        "\n",
        "\n",
        "# Create an object of Account\n",
        "account1 = Account(10000, 12345)  # Encapsulation ensures balance and account_no are private\n",
        "print(account1.get_balance())\n",
        "# Call methods to modify/access balance\n",
        "account1.debit(100)   # Withdraw 100\n",
        "account1.credit(500)  # Deposit 500\n",
        "\n",
        "# Safely access balance using getter\n",
        "print(account1.get_balance())"
