        "\n",
        "  def display(self): # Instance/ Object Method\n",
        "    print(f\"{self.name} got marks in three different subject are {self.marks}\")\n",
        "\n",
        "  # The Staticmethod logic is related to the class, but It does not depend on object data or class data\n",
        "  @staticmethod\n",
